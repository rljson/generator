# Copy to .env and adjust for your environment.

# URL of the running @rljson/server instance
SERVER_URL=http://localhost:3000

# Routes are NOT configured here — each generator in src/generators/index.ts
# declares its own route (see GeneratorEntry.route). The Server must be told
# to host every one of them via RLJSON_ROUTES (see the Server repo's
# .env.example) before "pnpm generate" can reach them.

# A large --count is chunked into batches (default: 10 records/batch, up to
# 2 batches in flight at once, 120s ACK timeout per batch) rather than sent
# as one giant sync, to keep the Server's ACK timeout from being hit. These
# defaults were tuned against one specific local machine/MSSQL instance —
# override per environment rather than editing src/generate.ts, and confirm
# empirically before raising GENERATE_BATCH_CONCURRENCY (higher concurrency
# can make individual batches slower via contention, not faster overall).
GENERATE_BATCH_SIZE=10
GENERATE_BATCH_CONCURRENCY=2
GENERATE_ACK_TIMEOUT_MS=120000

# Only used by "pnpm setup-server-tables" (one-time schema provisioning).
# MUST point at the SAME database/schema as the Server repo's .env.
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=rljson
MSSQL_SCHEMA=PantrySchema
MSSQL_USER=sa
MSSQL_PASSWORD=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=false
