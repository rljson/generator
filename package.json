{
  "name": "@rljson/generator",
  "version": "0.4.0",
  "description": "Headless RLJSON data generator — connects to @rljson/server as a Client and syncs generated data into the Server's database, no UI",
  "homepage": "https://github.com/rljson/generator",
  "bugs": "https://github.com/rljson/generator/issues",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.14.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rljson/generator.git"
  },
  "type": "module",
  "scripts": {
    "generate": "tsx src/cli.ts",
    "setup-server-tables": "tsx src/setup-server-tables.ts",
    "clear-server-tables": "tsx src/clear-server-tables.ts",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@rljson/bs": "^0.0.23",
    "@rljson/converter": "^0.0.43",
    "@rljson/db": "^0.0.20",
    "@rljson/hash": "^0.0.18",
    "@rljson/io": "^0.0.69",
    "@rljson/io-mssql": "^0.0.26",
    "@rljson/json": "^0.0.23",
    "@rljson/rljson": "^0.0.79",
    "@rljson/server": "^0.0.41",
    "mssql": "^12.2.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@rolldown/binding-win32-x64-msvc": "^1.2.0",
    "@types/mssql": "^9.1.8",
    "@types/node": "^25.9.2",
    "@vitest/coverage-v8": "^4.1.9",
    "tsx": "^4.19.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@rljson/rljson": "^0.0.79",
      "@rljson/hash": "^0.0.18"
    },
    "patchedDependencies": {
      "@rljson/io-mssql@0.0.26": "patches/@rljson__io-mssql@0.0.26.patch",
      "@rljson/io@0.0.69": "patches/@rljson__io@0.0.69.patch"
    }
  }
}
